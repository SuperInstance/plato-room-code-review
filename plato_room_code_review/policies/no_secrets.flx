// FLUX Policy: no_secrets.flx
// Alarm fires if diff contains secret-like strings
//
// This is a CRITICAL severity policy — secrets in diffs are security incidents.

POLICY no_secrets {
    SENSE  secret_like_count   // sensor: count of secret-pattern matches

    // Condition: any secret detected
    GUARD   secret_like_count > 0

    // Action — immediate, short cooldown
    ALARM   severity=critical
    ALARM   cooldown=60
    ACTUATE post_review value=2   // REQUEST_CHANGES immediately
    EMIT    "Potential hardcoded secrets detected in diff"
}

// Also block merge
POLICY no_secrets_block_merge {
    SENSE  secret_like_count

    GUARD   secret_like_count > 0

    ACTUATE apply_label value=2   // label: secrets-detected
    EMIT    "Merge blocked: secrets detected"
}

META {
    id:       "no_secrets"
    version:  "0.1.0"
    author:   "plato-room-code-review"
    tags:     ["security", "secrets", "critical"]
}
